{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QUICKFAST_BUILD_TESTS": "ON",
        "QUICKFAST_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default",
      "description": "Boost and Xerces-C come from the platform",
      "generator": "Ninja"
    },
    {
      "name": "vcpkg",
      "inherits": "base",
      "displayName": "vcpkg",
      "description": "Boost and Xerces-C are built by vcpkg; needs VCPKG_ROOT",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_FEATURES": "tests;examples"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "vcpkg", "configurePreset": "vcpkg" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg",
      "output": { "outputOnFailure": true }
    }
  ]
}
